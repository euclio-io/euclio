# Euclio — environment variables (names only; no real values here).
# Copy to .env.local and fill in. .env.local is gitignored.

# --- Neon Postgres (plan §4, §10) ---
# DATABASE_URL = POOLED connection (hostname contains "-pooler"). Used by the app (lib/prisma.ts).
# DIRECT_URL   = UNPOOLED connection (no "-pooler"). Used only by the Prisma CLI (prisma.config.ts).
DATABASE_URL=
DIRECT_URL=

# --- Clerk (plan §5) --- dashboard.clerk.com -> API Keys. Organizations OFF.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Sentry (added in plan §7) ---
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
