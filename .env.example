# Euclio — environment variables (names only; no real values here).
# Copy to .env.local and fill in. .env.local is gitignored.

# --- Neon Postgres (plan §4, §10) ---
# DATABASE_URL = POOLED connection (hostname contains "-pooler"). Used by the app (lib/prisma.ts).
# DIRECT_URL   = UNPOOLED connection (no "-pooler"). Used only by the Prisma CLI (prisma.config.ts).
DATABASE_URL=
DIRECT_URL=

# --- Clerk (plan §5) --- dashboard.clerk.com -> API Keys. Organizations OFF.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Sentry (plan §7) ---
# NEXT_PUBLIC_SENTRY_DSN = public DSN (ships in the browser bundle). Project Settings -> Client Keys.
# The three below are BUILD-TIME ONLY (source-map upload); the app runs without them.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Watcher worker (M3) ---
# Dead-man's-switch ping URL (Healthchecks.io or cron-job.org). If unset,
# the watcher logs a warning at startup and skips silently on each run.
DEADMANS_SWITCH_URL=

# Optional: override the debounce window before a missed heartbeat opens an
# incident. Defaults to 2 minutes.
WATCHER_DEBOUNCE_MINUTES=

# --- Alert email (M4) --- resend.com -> API Keys.
# RESEND_API_KEY: required for alert emails. If unset, mailer logs a warning
#   and skips silently — never crashes the watcher or ingest path.
# RESEND_FROM_ADDRESS: verified sender address in your Resend account.
#   Defaults to "Euclio <alerts@euclio.io>" if unset.
# APP_URL: public base URL of the web service (e.g. https://euclio-production.up.railway.app).
#   Used to build the dashboard link in alert emails. Defaults to the Railway URL above.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
APP_URL=

# --- Canary sensor (M5.2) --- resend.com -> Inbound -> Webhook signing secret.
# RESEND_INBOUND_SECRET: Svix signing secret for the POST /api/canary/inbound webhook.
#   Required for canary email receipt. If unset, the endpoint returns 500 and logs a warning.
#   Format: whsec_<base64>  (copy from Resend dashboard → Inbound → Webhook → Signing Secret)
RESEND_INBOUND_SECRET=
